# MAVERICK™ 4K Autonomous Film Director — Environment Configuration (.env.example)
# Copy to .env and fill in your local values. Never commit .env to version control.

# Local Kimi WebBridge daemon URL (default: http://127.0.0.1:10086)
WEBBRIDGE_DAEMON_URL=http://127.0.0.1:10086

# Your Google Flow project UUID (from https://flow.google.com/u/1/project/<FLOW_PROJECT_ID>)
FLOW_PROJECT_ID=00000000-0000-0000-0000-flowproject01

# High-capacity scratch directory for 4K parallel frame streaming
MAVERICK_TEMP_DIR=./workspace/.hf-temp

# Optional: ElevenLabs API Key for character-aligned narration synthesis (eleven_v4)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
